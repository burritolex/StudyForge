# ==============================================================================
# StudyForge Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=studyforge
POSTGRES_USER=studyforge_user
POSTGRES_PASSWORD=replace_with_a_secure_password
POSTGRES_PORT=5432
DB_HOST=localhost

# JDBC Connection URL for Spring Boot (when running locally outside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/studyforge
# Database connection for Python AI service (asyncpg connection string)
DATABASE_URL=postgresql://studyforge_user:replace_with_a_secure_password@localhost:5432/studyforge

# ------------------------------------------------------------------------------
# Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
SERVER_PORT=8080
# 256-bit Base64-encoded secret key for signing JWT tokens (HMAC-SHA256)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=900000                 # 15 minutes in milliseconds
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Internal secret header for Spring Boot <-> FastAPI private communication
INTERNAL_SERVICE_KEY=studyforge_internal_dev_secret_key_change_in_production

# Local storage path for uploaded course material PDFs
STORAGE_LOCAL_DIRECTORY=./uploads

# ------------------------------------------------------------------------------
# Python FastAPI AI Service Configuration
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
AI_SERVICE_HOST=0.0.0.0
AI_SERVICE_URL=http://localhost:8000

# Google Gemini API Credentials
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_LLM_MODEL=gemini-3.8-flash
# Note: Gemini Embedding 2 defaults to 3072 dimensions; StudyForge explicitly selects the supported 768-dimensional output to optimize vector storage and compute
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api/v1
